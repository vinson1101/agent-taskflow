{
  "name": "AgentTaskFlow",
  "version": "2.0.0",
  "description": "A2A-compatible reliability control plane for session-based agents",
  "author": "PinchyMeow",
  "main": "index.js",
  "bin": {
    "atf": "./atf-cli.js"
  },
  "scripts": {
    "start": "node index.js",
    "atf:watcher": "node workspace/bin/atf-watcher.cjs",
    "atf:watcher:dry": "node workspace/bin/atf-watcher.cjs --dry-run",
    "atf:watcher:smoke": "node workspace/bin/atf-watcher-smoke.cjs",
    "atf:action:watcher": "node workspace/bin/atf-action-watcher.cjs",
    "atf:action:watcher:dry": "node workspace/bin/atf-action-watcher.cjs --dry-run",
    "atf:launcher": "node workspace/bin/atf-launcher.cjs",
    "atf:launcher:dry": "node workspace/bin/atf-launcher.cjs --dry-run",
    "atf:control-plane": "node workspace/bin/atf-control-plane.cjs",
    "atf:control-plane:dry": "node workspace/bin/atf-control-plane.cjs --dry-run",
    "atf:control-plane:smoke": "node workspace/bin/atf-control-plane-smoke.cjs",
    "atf:event-dispatcher": "node workspace/bin/atf-event-dispatcher.cjs",
    "atf:phasec:smoke": "node workspace/bin/atf-phasec-smoke.cjs",
    "atf:phased:smoke": "node workspace/bin/atf-phased-smoke.cjs",
    "atf:reliability:smoke": "node workspace/bin/atf-reliability-smoke.cjs",
    "test": "node workspace/bin/atf-phasec-smoke.cjs --cleanup --quiet && node workspace/bin/atf-watcher-smoke.cjs --cleanup --quiet && node workspace/bin/atf-control-plane-smoke.cjs --cleanup --quiet && node workspace/bin/atf-phased-smoke.cjs --cleanup --quiet && node workspace/bin/atf-reliability-smoke.cjs"
  },
  "keywords": [
    "openclaw",
    "hermes-agent",
    "a2a",
    "taskflow",
    "multi-agent",
    "coordination",
    "control-plane",
    "orchestration"
  ],
  "dependencies": {},
  "engines": {
    "node": ">=22.0.0"
  }
}
