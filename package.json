{
  "name": "AgentTaskFlow",
  "version": "1.0.0",
  "description": "Async multi-agent coordination kernel and control plane for OpenClaw",
  "author": "PinchyMeow",
  "main": "index.js",
  "bin": {
    "atf": "./atf-cli.js"
  },
  "scripts": {
    "start": "node index.js",
    "atf:watcher": "node workspace/bin/atf-watcher.cjs",
    "atf:watcher:dry": "node workspace/bin/atf-watcher.cjs --dry-run",
    "atf:action:watcher": "node workspace/bin/atf-action-watcher.cjs",
    "atf:action:watcher:dry": "node workspace/bin/atf-action-watcher.cjs --dry-run",
    "atf:launcher": "node workspace/bin/atf-launcher.cjs",
    "atf:launcher:dry": "node workspace/bin/atf-launcher.cjs --dry-run",
    "atf:control-plane": "node workspace/bin/atf-control-plane.cjs",
    "atf:control-plane:dry": "node workspace/bin/atf-control-plane.cjs --dry-run",
    "atf:phasec:smoke": "node workspace/bin/atf-phasec-smoke.cjs",
    "atf:phased:smoke": "node workspace/bin/atf-phased-smoke.cjs",
    "test": "jest"
  },
  "keywords": [
    "openclaw",
    "taskflow",
    "multi-agent",
    "coordination",
    "control-plane",
    "orchestration"
  ],
  "dependencies": {
    "ethers": "^6.16.0",
    "viem": "^2.46.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
